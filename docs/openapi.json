  "components": {
    "schemas": {
      "Envelope": {
        "type": "object",
        "required": [
          "schemaVersion",
          "observerId",
          "generatedAt",
          "windowStart",
          "windowEnd",
          "methodVersion",
          "dataQuality",
          "result"
        ],
        "properties": {
          "schemaVersion": {
            "const": "1.0"
          },
          "observerId": {
            "type": "string"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "windowStart": {
            "type": "string",
            "format": "date-time"
          },
          "windowEnd": {
            "type": "string",
            "format": "date-time"
          },
          "methodVersion": {
            "const": "collection-1"
          },
          "dataQuality": {
            "$ref": "#/components/schemas/DataQuality"
          },
          "result": {
            "type": "object"
          }
        }
      },
      "DataQuality": {
        "type": "object",
        "properties": {
          "rankingsAvailable": {
            "const": false
          },
          "producerSoftwareVersion": {
            "type": "null"
          },
          "rawRetentionDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "legacyFeasibilityImported": {
            "const": false
          },
          "analysisState": {
            "const": "not_implemented"
          },
          "captureState": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "Page": {
        "type": "object",
        "required": [
          "data",
          "nextOffset"
        ],
        "properties": {
          "data": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object"
            }
          },
          "nextOffset": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "Momentum": {
        "type": "object",
        "required": [
          "hash",
          "height",
          "producerAddress",
          "verificationState",
          "producerSoftwareVersion"
        ],
        "properties": {
          "hash": {
            "type": "string"
          },
          "height": {
            "type": "integer"
          },
          "previousHash": {
            "type": "string"
          },
          "timestamp": {
            "type": "integer"
          },
          "producerAddress": {
            "type": [
              "string",
              "null"
            ]
          },
          "producerSoftwareVersion": {
            "type": "null"
          },
          "protocolVersion": {
            "type": "integer"
          },
          "signerConflict": {
            "type": "boolean"
          },
          "verificationState": {
            "enum": [
              "signature_checked",
              "rpc_observed",
              "rpc_agreed",
              "disputed"
            ]
          },
          "source": {
            "type": "string"
          },
          "firstObservedAt": {
            "type": "string",
            "format": "date-time"
          },
          "referenceCheckedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Arrival": {
        "type": "object",
        "required": [
          "bootId",
          "sessionId",
          "hash",
          "eventKind",
          "arrivedAt",
          "monotonicNs",
          "eligible",
          "rankingEligible"
        ],
        "properties": {
          "observerId": {
            "type": "string"
          },
          "bootId": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "peerId": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "eventKind": {
            "type": "string"
          },
          "arrivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "monotonicNs": {
            "type": "integer"
          },
          "duplicateCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "eligible": {
            "type": "boolean"
          },
          "exclusionReason": {
            "type": "string"
          },
          "rankingEligible": {
            "const": false
          },
          "verificationState": {
            "type": "string"
          },
          "producerAddress": {
            "type": [
              "string",
              "null"
            ]
          },
          "ip": {
            "type": "string"
          },
          "advertisedVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "versionObservedAt": {
            "type": "string",
            "format": "date-time"
          },
          "producerSoftwareVersion": {
            "type": "null"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "sessionId",
          "bootId",
          "peerId",
          "ip",
          "advertisedVersion",
          "connectedAt",
          "disconnectedAt"
        ],
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "bootId": {
            "type": "string"
          },
          "peerId": {
            "type": "string"
          },
          "ip": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "clientName": {
            "type": "string"
          },
          "advertisedVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "versionObservedAt": {
            "type": "string",
            "format": "date-time"
          },
          "connectedAt": {
            "type": "string",
            "format": "date-time"
          },
          "disconnectedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "disconnectReason": {
            "type": "string"
          },
          "statusCompletedMonoNs": {
            "type": "integer"
          },
          "disconnectedMonoNs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "uncleanShutdown": {
            "type": "boolean"
          }
        }
      }
    }
  }
