OBSERVER_ID=choose-a-stable-observer-name
MAX_PEERS=4
MAX_DIALS=1
RUN_DURATION=65m
PEER_ROTATION_ENABLED=false
# Comma-separated full public keys with explicit public endpoint ports.
# DNS names are supported; every answer must be public at dial time.
PEER_SEEDS=
RPC_REFERENCE_URLS=wss://my.hc1node.com:35998,wss://node.zenonhub.io:35998,wss://node.atsocy.com:35998
DATA_BUDGET_MIB=2048
INGRESS_BUDGET_MIB_PER_HOUR=250
EGRESS_BUDGET_MIB_PER_HOUR=50
